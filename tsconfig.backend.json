{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "./dist/backend",
    "rootDir": ".",
    "sourceMap": true,
    "target": "ES2020",
    "types": ["node"]
  },
  "include": ["backend/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist"]
}
